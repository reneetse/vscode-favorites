{
  "name": "vscode-favorites",
  "displayName": "favorites",
  "description": "Mark resources (files or folders, local and remote) as favorites, so they can be easily accessed.",
  "version": "1.16.0",
  "publisher": "howardzuo",
  "engines": {
    "vscode": "^1.80.0"
  },
  "scripts": {
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "compile": "npm run sync:menus && npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "build": "npm run package",
    "package": "node scripts/package.cjs",
    "pub": "vsce publish",
    "clean": "rimraf out dist *.vsix",
    "test": "npm run test:batch",
    "test:batch": "npm run sync:menus && node --test test/*.test.cjs",
    "sync:menus": "node scripts/localize-menus.cjs"
  },
  "categories": [
    "Other"
  ],
  "icon": "images/favorites.png",
  "bugs": {
    "url": "https://github.com/leftstick/vscode-favorites/issues",
    "email": "leftstick@qq.com"
  },
  "homepage": "https://github.com/leftstick/vscode-favorites/blob/master/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/leftstick/vscode-favorites.git"
  },
  "activationEvents": [
    "onCommand:favorites.addToFavorites",
    "onView:favorites",
    "onView:favorites-full-view",
    "onStartupFinished"
  ],
  "license": "GPL-3.0",
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Favorites",
      "properties": {
        "favorites.resources": {
          "type": "array",
          "default": [],
          "description": "%configuration.resources.description%"
        },
        "favorites.sortOrder": {
          "type": "string",
          "enum": [
            "ASC",
            "DESC",
            "MTIME_DESC",
            "MTIME_ASC",
            "FILETYPE",
            "MANUAL"
          ],
          "default": "ASC",
          "description": "%configuration.sortOrder.description%",
          "enumDescriptions": [
            "%sort.ASC%",
            "%sort.DESC%",
            "%sort.MTIME_DESC%",
            "%sort.MTIME_ASC%",
            "%sort.FILETYPE%",
            "%sort.MANUAL%"
          ]
        },
        "favorites.currentGroup": {
          "type": "string",
          "default": "Default",
          "description": "%configuration.currentGroup.description%"
        },
        "favorites.groups": {
          "type": "array",
          "default": [
            "Default"
          ],
          "description": "%configuration.groups.description%"
        },
        "favorites.saveSeparated": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.saveSeparated.description%"
        },
        "favorites.language": {
          "type": "string",
          "enum": [
            "zh-CN",
            "en",
            "auto"
          ],
          "default": "zh-CN",
          "description": "%configuration.language.description%",
          "enumDescriptions": [
            "始终使用中文 / Always use Chinese",
            "始终使用英文 / Always use English",
            "跟随 VS Code / Follow VS Code"
          ]
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "favorites-explorer",
          "title": "Favorites",
          "icon": "$(heart)"
        }
      ]
    },
    "views": {
      "favorites-explorer": [
        {
          "id": "favorites-full-view",
          "name": "%view.favorites.title%"
        }
      ],
      "explorer": [
        {
          "id": "favorites",
          "name": "%view.favorites.title%",
          "when": "config.favorites.resources.length > 0"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "favorites.addToFavorites",
          "group": "favorites",
          "when": "config.favorites.groups.length <= 1 && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))"
        },
        {
          "command": "favorites.localized.en.addToFavorites",
          "group": "favorites",
          "when": "config.favorites.groups.length <= 1 && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))"
        },
        {
          "command": "favorites.addToFavoritesGroup",
          "group": "favorites",
          "when": "config.favorites.groups.length > 1 && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))"
        },
        {
          "command": "favorites.localized.en.addToFavoritesGroup",
          "group": "favorites",
          "when": "config.favorites.groups.length > 1 && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))"
        },
        {
          "command": "favorites.deleteFavorite",
          "group": "favorites",
          "when": "(config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))"
        },
        {
          "command": "favorites.localized.en.deleteFavorite",
          "group": "favorites",
          "when": "(config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))"
        }
      ],
      "explorer/context": [
        {
          "command": "favorites.addToFavorites",
          "group": "favorites",
          "when": "config.favorites.groups.length <= 1 && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))"
        },
        {
          "command": "favorites.localized.en.addToFavorites",
          "group": "favorites",
          "when": "config.favorites.groups.length <= 1 && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))"
        },
        {
          "command": "favorites.addToFavoritesGroup",
          "group": "favorites",
          "when": "config.favorites.groups.length > 1 && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))"
        },
        {
          "command": "favorites.localized.en.addToFavoritesGroup",
          "group": "favorites",
          "when": "config.favorites.groups.length > 1 && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))"
        }
      ],
      "view/title": [
        {
          "command": "favorites.nav.refresh",
          "when": "view in ext:allFavoriteViews && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "navigation"
        },
        {
          "command": "favorites.localized.en.nav.refresh",
          "when": "view in ext:allFavoriteViews && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "navigation"
        },
        {
          "command": "favorites.nav.sort",
          "when": "view in ext:allFavoriteViews && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "navigation"
        },
        {
          "command": "favorites.localized.en.nav.sort",
          "when": "view in ext:allFavoriteViews && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "navigation"
        },
        {
          "command": "favorites.group.changeGroup",
          "when": "view in ext:allFavoriteViews && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "navigation"
        },
        {
          "command": "favorites.localized.en.group.changeGroup",
          "when": "view in ext:allFavoriteViews && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "navigation"
        },
        {
          "command": "favorites.group.newGroup",
          "when": "view in ext:allFavoriteViews && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "navigation"
        },
        {
          "command": "favorites.localized.en.group.newGroup",
          "when": "view in ext:allFavoriteViews && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "favorites.revealInOS.mac",
          "when": "isMac && view in ext:allFavoriteViews && viewItem =~ /^resource/ && !listMultiSelection && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "navigation"
        },
        {
          "command": "favorites.localized.en.revealInOS.mac",
          "when": "isMac && view in ext:allFavoriteViews && viewItem =~ /^resource/ && !listMultiSelection && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "navigation"
        },
        {
          "command": "favorites.revealInOS.windows",
          "when": "isWindows && view in ext:allFavoriteViews && viewItem =~ /^resource/ && !listMultiSelection && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "navigation"
        },
        {
          "command": "favorites.localized.en.revealInOS.windows",
          "when": "isWindows && view in ext:allFavoriteViews && viewItem =~ /^resource/ && !listMultiSelection && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "navigation"
        },
        {
          "command": "favorites.revealInOS.other",
          "when": "!isMac && !isWindows && view in ext:allFavoriteViews && viewItem =~ /^resource/ && !listMultiSelection && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "navigation"
        },
        {
          "command": "favorites.localized.en.revealInOS.other",
          "when": "!isMac && !isWindows && view in ext:allFavoriteViews && viewItem =~ /^resource/ && !listMultiSelection && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "navigation"
        },
        {
          "command": "favorites.revealInSideBar",
          "when": "view in ext:allFavoriteViews && !listMultiSelection && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "navigation"
        },
        {
          "command": "favorites.localized.en.revealInSideBar",
          "when": "view in ext:allFavoriteViews && !listMultiSelection && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "navigation"
        },
        {
          "command": "favorites.openToSide",
          "when": "view in ext:allFavoriteViews && viewItem =~ /^resource(Child)?$|^uri\\.resource(Child)?$/ && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "navigation"
        },
        {
          "command": "favorites.localized.en.openToSide",
          "when": "view in ext:allFavoriteViews && viewItem =~ /^resource(Child)?$|^uri\\.resource(Child)?$/ && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "navigation"
        },
        {
          "command": "favorites.deleteFavorite",
          "when": "view in ext:allFavoriteViews && viewItem =~ /resource(\\.dir)?$/ && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "operation"
        },
        {
          "command": "favorites.localized.en.deleteFavorite",
          "when": "view in ext:allFavoriteViews && viewItem =~ /resource(\\.dir)?$/ && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "operation"
        },
        {
          "command": "favorites.copyFileName",
          "when": "view in ext:allFavoriteViews && viewItem =~ /^(uri\\.)?resource(Child)?(\\.dir)?$/ && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "copy@1"
        },
        {
          "command": "favorites.localized.en.copyFileName",
          "when": "view in ext:allFavoriteViews && viewItem =~ /^(uri\\.)?resource(Child)?(\\.dir)?$/ && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "copy@1"
        },
        {
          "command": "favorites.copyFilePath",
          "when": "view in ext:allFavoriteViews && viewItem =~ /^(uri\\.)?resource(Child)?(\\.dir)?$/ && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "copy@2"
        },
        {
          "command": "favorites.localized.en.copyFilePath",
          "when": "view in ext:allFavoriteViews && viewItem =~ /^(uri\\.)?resource(Child)?(\\.dir)?$/ && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "copy@2"
        },
        {
          "command": "favorites.copyRelativePath",
          "when": "view in ext:allFavoriteViews && viewItem =~ /^(uri\\.)?resource(Child)?(\\.dir)?$/ && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "copy@3"
        },
        {
          "command": "favorites.localized.en.copyRelativePath",
          "when": "view in ext:allFavoriteViews && viewItem =~ /^(uri\\.)?resource(Child)?(\\.dir)?$/ && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "copy@3"
        },
        {
          "command": "favorites.moveToTop",
          "when": "view in ext:allFavoriteViews && viewItem =~ /resource(\\.dir)?$/ && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "sort@1"
        },
        {
          "command": "favorites.localized.en.moveToTop",
          "when": "view in ext:allFavoriteViews && viewItem =~ /resource(\\.dir)?$/ && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "sort@1"
        },
        {
          "command": "favorites.moveUp",
          "when": "view in ext:allFavoriteViews && viewItem =~ /resource(\\.dir)?$/ && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "sort@2"
        },
        {
          "command": "favorites.localized.en.moveUp",
          "when": "view in ext:allFavoriteViews && viewItem =~ /resource(\\.dir)?$/ && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "sort@2"
        },
        {
          "command": "favorites.moveDown",
          "when": "view in ext:allFavoriteViews && viewItem =~ /resource(\\.dir)?$/ && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "sort@3"
        },
        {
          "command": "favorites.localized.en.moveDown",
          "when": "view in ext:allFavoriteViews && viewItem =~ /resource(\\.dir)?$/ && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "sort@3"
        },
        {
          "command": "favorites.moveToBottom",
          "when": "view in ext:allFavoriteViews && viewItem =~ /resource(\\.dir)?$/ && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "sort@4"
        },
        {
          "command": "favorites.localized.en.moveToBottom",
          "when": "view in ext:allFavoriteViews && viewItem =~ /resource(\\.dir)?$/ && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "sort@4"
        },
        {
          "command": "favorites.stage",
          "when": "view in ext:allFavoriteViews && (resourceScheme == file || resourceScheme == vscode-remote) && viewItem =~ /^(uri\\.)?resource(Child)?$/ && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "git"
        },
        {
          "command": "favorites.localized.en.stage",
          "when": "view in ext:allFavoriteViews && (resourceScheme == file || resourceScheme == vscode-remote) && viewItem =~ /^(uri\\.)?resource(Child)?$/ && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "git"
        },
        {
          "command": "favorites.forceStage",
          "when": "view in ext:allFavoriteViews && (resourceScheme == file || resourceScheme == vscode-remote) && viewItem =~ /^(uri\\.)?resource(Child)?$/ && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "git"
        },
        {
          "command": "favorites.localized.en.forceStage",
          "when": "view in ext:allFavoriteViews && (resourceScheme == file || resourceScheme == vscode-remote) && viewItem =~ /^(uri\\.)?resource(Child)?$/ && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "git"
        },
        {
          "command": "favorites.newFolder",
          "when": "view in ext:allFavoriteViews && viewItem =~ /^(uri\\.)?resource(Child)?(\\.dir)?$/ && !listMultiSelection && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "file@1"
        },
        {
          "command": "favorites.localized.en.newFolder",
          "when": "view in ext:allFavoriteViews && viewItem =~ /^(uri\\.)?resource(Child)?(\\.dir)?$/ && !listMultiSelection && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "file@1"
        },
        {
          "command": "favorites.moveToFolder",
          "when": "view in ext:allFavoriteViews && viewItem =~ /^(uri\\.)?resource(Child)?(\\.dir)?$/ && (config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))",
          "group": "file@2"
        },
        {
          "command": "favorites.localized.en.moveToFolder",
          "when": "view in ext:allFavoriteViews && viewItem =~ /^(uri\\.)?resource(Child)?(\\.dir)?$/ && (config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))",
          "group": "file@2"
        }
      ],
      "commandPalette": [
        {
          "command": "favorites.nav.refresh",
          "when": "false"
        },
        {
          "command": "favorites.localized.en.nav.refresh",
          "when": "false"
        },
        {
          "command": "favorites.nav.sort",
          "when": "false"
        },
        {
          "command": "favorites.localized.en.nav.sort",
          "when": "false"
        },
        {
          "command": "favorites.revealInOS.mac",
          "when": "false"
        },
        {
          "command": "favorites.localized.en.revealInOS.mac",
          "when": "false"
        },
        {
          "command": "favorites.revealInOS.windows",
          "when": "false"
        },
        {
          "command": "favorites.localized.en.revealInOS.windows",
          "when": "false"
        },
        {
          "command": "favorites.revealInOS.other",
          "when": "false"
        },
        {
          "command": "favorites.localized.en.revealInOS.other",
          "when": "false"
        },
        {
          "command": "favorites.revealInSideBar",
          "when": "false"
        },
        {
          "command": "favorites.localized.en.revealInSideBar",
          "when": "false"
        },
        {
          "command": "favorites.openToSide",
          "when": "false"
        },
        {
          "command": "favorites.localized.en.openToSide",
          "when": "false"
        },
        {
          "command": "favorites.copyFileName",
          "when": "false"
        },
        {
          "command": "favorites.localized.en.copyFileName",
          "when": "false"
        },
        {
          "command": "favorites.copyFilePath",
          "when": "false"
        },
        {
          "command": "favorites.localized.en.copyFilePath",
          "when": "false"
        },
        {
          "command": "favorites.copyRelativePath",
          "when": "false"
        },
        {
          "command": "favorites.localized.en.copyRelativePath",
          "when": "false"
        },
        {
          "command": "favorites.moveToTop",
          "when": "false"
        },
        {
          "command": "favorites.localized.en.moveToTop",
          "when": "false"
        },
        {
          "command": "favorites.moveUp",
          "when": "false"
        },
        {
          "command": "favorites.localized.en.moveUp",
          "when": "false"
        },
        {
          "command": "favorites.moveDown",
          "when": "false"
        },
        {
          "command": "favorites.localized.en.moveDown",
          "when": "false"
        },
        {
          "command": "favorites.moveToBottom",
          "when": "false"
        },
        {
          "command": "favorites.localized.en.moveToBottom",
          "when": "false"
        },
        {
          "command": "favorites.stage",
          "when": "false"
        },
        {
          "command": "favorites.localized.en.stage",
          "when": "false"
        },
        {
          "command": "favorites.forceStage",
          "when": "false"
        },
        {
          "command": "favorites.localized.en.forceStage",
          "when": "false"
        },
        {
          "command": "favorites.newFolder",
          "when": "false"
        },
        {
          "command": "favorites.localized.en.newFolder",
          "when": "false"
        },
        {
          "command": "favorites.moveToFolder",
          "when": "false"
        },
        {
          "command": "favorites.localized.en.moveToFolder",
          "when": "false"
        },
        {
          "command": "favorites.group.changeGroup",
          "when": "(config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))"
        },
        {
          "command": "favorites.localized.en.group.changeGroup",
          "when": "(config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))"
        },
        {
          "command": "favorites.group.newGroup",
          "when": "(config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))"
        },
        {
          "command": "favorites.localized.en.group.newGroup",
          "when": "(config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))"
        },
        {
          "command": "favorites.addToFavorites",
          "when": "(config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))"
        },
        {
          "command": "favorites.localized.en.addToFavorites",
          "when": "(config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))"
        },
        {
          "command": "favorites.deleteFavorite",
          "when": "(config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))"
        },
        {
          "command": "favorites.localized.en.deleteFavorite",
          "when": "(config.favorites.language == en || (config.favorites.language == auto && ext:favoritesEnglish))"
        },
        {
          "command": "favorites.toggleFavorite",
          "when": "(config.favorites.language != en && (config.favorites.language != auto || !ext:favoritesEnglish))"
        },
        {
          "command": "favorites.localized.en.toggleFavorite",
